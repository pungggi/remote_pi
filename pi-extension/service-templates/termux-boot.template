#!/data/data/com.termux/files/usr/bin/sh
# start-piper.sh — Remote Pi on Termux (plan/173). Generated by `remote-pi install`.
#
# Termux:Boot runs every script in ~/.termux/boot after the device starts.
# It is also safe to run by hand at any time: each step below is idempotent.
#   - a second supervisor exits at once (it refuses to run next to a live one)
#   - a second guard exits at once (pid file lock)
# To stop everything on purpose: remote-pi guard stop && remote-pi daemon stop
# Logs: ~/.pi/piper/supervisord.log and ~/.pi/piper/guard.log

export HOME="{HOME}"
# Termux:Boot starts with a minimal PATH. node, pi and tmux live in the prefix.
export PATH="{PREFIX}/bin:{PATH}"
export PREFIX="{PREFIX}"
# Shared libraries of Termux packages (node's native modules among them).
[ -z "$LD_LIBRARY_PATH" ] && export LD_LIBRARY_PATH="{PREFIX}/lib"

PIPER="$HOME/.pi/piper"
mkdir -p "$PIPER"

# Keep the CPU awake while the phone sits idle. Without the lock Android
# dozes the app after a while and the relay connections drop.
if command -v termux-wake-lock >/dev/null 2>&1; then
  termux-wake-lock
fi

# Supervisor: the always-on device daemon plus the registered project daemons.
nohup "{NODE}" "{SUPERVISOR}" >>"$PIPER/supervisord.log" 2>&1 &

# Guard: restarts the supervisor when it is gone and keeps the device daemon
# up. On a PC the service manager does this; Termux has none.
nohup "{NODE}" "{REMOTE_PI}" guard run >>"$PIPER/guard.log" 2>&1 &
