<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Idiomas que o bundle declara suportar. É o que faz o macOS localizar os
	     itens que ELE desenha no menu do app (About/Services/Hide/Show All/Quit)
	     e nos diálogos do sistema — esses não passam pelo slang. Sem esta chave o
	     SO trata o app como inglês-apenas e ignora o idioma do usuário.
	     Manter em sincronia com lib/i18n/*.i18n.json. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>pt_BR</string>
		<string>es</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Remote Pi Cockpit</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>FLTEnableMergedPlatformUIThread</key>
	<false/>
	<!-- Plano 47 — self-update via Sparkle (pacote auto_updater). Chave pública
	     EdDSA deste fork, a mesma do EdDSAPub em windows/runner/Runner.rc (uma
	     seed ed25519 serve aos dois motores); a privada é o secret
	     SPARKLE_PRIVATE_KEY. O feed (appcast-macos.xml) é setado em runtime via
	     setFeedURL (delegate do plugin), então NÃO há SUFeedURL aqui — o Sparkle
	     2 lança exceção se houver delegate de feed E SUFeedURL juntos.

	     INERTE hoje: o fork não publica release de macOS (sem identidade de
	     assinatura Apple), então nada consome este appcast. A chave foi trocada
	     junto com a do Windows mesmo assim — deixar a do upstream aqui seria
	     manter uma âncora de confiança de terceiro esperando ser reativada. -->
	<key>SUPublicEDKey</key>
	<string>SgNmu3IHpmS/lIUAEgyjkrrIQGe2cOBshp4pOJLc8pE=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
