<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is required for the relay WebSocket. Debug and profile
         manifests already declare it for hot-reload, but the release
         build inherits only from src/main; without this line a signed
         APK ships with no network access at all. ACCESS_NETWORK_STATE
         lets the app detect offline state without polling. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Plan 29 — voice input. RECORD_AUDIO feeds on-device speech
         recognition; audio is transcribed locally and never written to a
         file nor sent to any server. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Plan 30 — image attachments. CAMERA covers the photo-capture path;
         the gallery uses the Android Photo Picker (no storage permission). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Plan 103 — foreground service that keeps the relay WebSocket alive
         while the app is backgrounded. dataSync is the canonical type for a
         persistent data connection (Android 15 caps it at 6 h; the WS then
         drops and reconnects on next foreground). POST_NOTIFICATIONS is the
         Android 13+ runtime permission for the required FG notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Piper"
        android:name="${applicationName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Plan/104 — receive a shared image from the Android Share sheet
                 (Gallery, screenshot Share, Files, browsers). The system
                 delivers the image URI in EXTRA_STREAM with a read grant. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Plan 103 — foreground "priority anchor" service. Holds the
             persistent notification that elevates the app process to
             foreground priority so Android does not freeze it (and the relay
             WS) on background. The service runs no Dart. -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Plan 29 — Android 11+ (API 30) package visibility: lets
             speech_to_text discover the on-device recognition service.
             Without this, locales()/listen() find no provider. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Plan 32b — url_launcher opening https links from rendered
             markdown (Android 11+ package visibility). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
